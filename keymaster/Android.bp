// Pinned BoringSSL/keymaster copies for stock blobs.
// Installed as Soong modules (not raw files) so vendor prebuilt
// DT_NEEDED entries resolve at build time.
cc_prebuilt_library_shared {
    name: "libcrypto-v29",
    owner: "samsung",
    vendor: true,
    target: {
        android_arm64: {
            srcs: ["libcrypto-v29.so"],
        },
    },
    strip: {
        none: true,
    },
}

cc_prebuilt_library_shared {
    name: "libkeymaster_portable-v29",
    owner: "samsung",
    vendor: true,
    target: {
        android_arm64: {
            srcs: ["libkeymaster_portable-v29.so"],
        },
    },
    strip: {
        none: true,
    },
}

cc_prebuilt_library_shared {
    name: "libpuresoftkeymasterdevice-v29",
    owner: "samsung",
    vendor: true,
    target: {
        android_arm64: {
            srcs: ["libpuresoftkeymasterdevice-v29.so"],
        },
    },
    strip: {
        none: true,
    },
}

cc_prebuilt_library_shared {
    name: "libsoftkeymasterdevice-v29",
    owner: "samsung",
    vendor: true,
    target: {
        android_arm64: {
            srcs: ["libsoftkeymasterdevice-v29.so"],
        },
    },
    strip: {
        none: true,
    },
}
